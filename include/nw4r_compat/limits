// nw4r_compat: std:: wrappers over the repo's MSL headers so the nw4r sources build.
// Only on the include path of the NW4R library in configure.py. Not matching-accurate.
#ifndef NW4R_COMPAT_LIMITS
#define NW4R_COMPAT_LIMITS
namespace std {
template <typename T> struct numeric_limits {};
template <> struct numeric_limits<float> { static float max() { return 3.4028235e38f; } static float min() { return 1.17549435e-38f; } static float epsilon() { return 1.1920929e-7f; } };
template <> struct numeric_limits<int> { static int max() { return 0x7fffffff; } static int min() { return -0x7fffffff - 1; } };
template <> struct numeric_limits<unsigned int> { static unsigned int max() { return 0xffffffff; } static unsigned int min() { return 0; } };
template <> struct numeric_limits<long> { static long max() { return 0x7fffffff; } static long min() { return -0x7fffffff - 1; } };
template <> struct numeric_limits<unsigned long> { static unsigned long max() { return 0xffffffff; } static unsigned long min() { return 0; } };
template <> struct numeric_limits<short> { static short max() { return 0x7fff; } static short min() { return -0x8000; } };
template <> struct numeric_limits<unsigned short> { static unsigned short max() { return 0xffff; } static unsigned short min() { return 0; } };
template <> struct numeric_limits<signed char> { static signed char max() { return 127; } static signed char min() { return -128; } };
template <> struct numeric_limits<unsigned char> { static unsigned char max() { return 255; } static unsigned char min() { return 0; } };
}
#endif
