inline char* strncat(char* d, const char* s, size_t n) { return ::strncat(d, (char*)s, n); }
using ::memset; using ::memcpy; using ::memcmp; using ::memmove; using ::strncpy; using ::strlen; using ::strcmp;
using ::strncmp; using ::stricmp; using ::strcpy; using ::strcat; using ::strchr; using ::uintptr_t;
